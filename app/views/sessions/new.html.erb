<h1>Login</h1>

<%= form_with url: login_path do %>
  <div>
    <%= label_tag :login, "Email ou matrícula" %>
    <%= text_field_tag :login %>
  </div>

  <div>
    <%= label_tag :senha, "Senha" %>
    <%= password_field_tag :senha %>
  </div>

  <div>
    <%= submit_tag "Entrar" %>
  </div>
<% end %>

<%= button_to "Esqueci minha senha", redefinir_senha_path, method: :get %>
