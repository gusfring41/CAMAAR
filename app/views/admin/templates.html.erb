<div class="templates-grid">
  <% @templates.each do |template| %>
    <div class="card">
      <div class="card-content">
        <h2 class="template-title"><%= template.nome %></h2>
        <p class="template-semester">Semestre: N/A</p>
      </div>
      
      <div class="card-actions">
        <%= link_to svg_icon('edit', class: 'icon-edit'), "#", class: "action-btn" %>
        <%= link_to svg_icon('trash', class: 'icon-delete'), "#", class: "action-btn" %>
      </div>
    </div>
  <% end %>

  <a href="#" class="card-create-new">
    <div class="plus-icon">+</div>
  </a>
</div>